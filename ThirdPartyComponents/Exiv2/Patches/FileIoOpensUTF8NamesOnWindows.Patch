 #ifdef EXV_ENABLE_FILESYSTEM
+#ifdef _WIN32
+namespace {
+// IPAM's patch (Exiv2's main has the same since https://github.com/Exiv2/exiv2/pull/3117): a FileIo's path is UTF-8,
+// opened by its wide name - the C runtime reads a narrow name in the code page, which cannot name every file
+std::wstring wideName(const std::string& utf8) {
+  if (utf8.empty())
+    return {};
+  const int n = MultiByteToWideChar(CP_UTF8, 0, utf8.data(), static_cast<int>(utf8.size()), nullptr, 0);
+  std::wstring result(n, wchar_t{});
+  MultiByteToWideChar(CP_UTF8, 0, utf8.data(), static_cast<int>(utf8.size()), result.data(), n);
+  return result;
+}
+FILE* fopenUtf8(const std::string& path, const std::string& mode) {
+  return _wfopen(wideName(path).c_str(), wideName(mode).c_str());
+}
+}  // namespace
+#endif
